APP_ENV=production
APP_DEBUG=false
APP_NAME="Clinique Obstétrique"
APP_URL=http://localhost:8000
APP_KEY=base64:change_this_to_random_32_chars

# Database - Railway / Local
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinique_obstetrique
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_SAMESITE=Lax

# Mail (optionnel)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@clinique.local
MAIL_FROM_NAME="Clinique Obstétrique"

# Sécurité
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
